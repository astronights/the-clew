# Neon Postgres connection string (pooled). Optional locally: without it the
# verdict cache, stats and rate limiting are skipped.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Google Gemini API key for judging free-text rule guesses.
GEMINI_API_KEY=
# Gemini model name (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional salt for hashing IPs in the rate_limit table.
IP_HASH_SALT=change-me
# Password for the /admin puzzle desk (12+ characters). Admin is disabled when unset.
ADMIN_TOKEN=
# Optional: a different (stronger) Gemini model just for writing puzzles.
GEMINI_GENERATOR_MODEL=
