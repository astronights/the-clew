# Neon Postgres connection string (pooled). Optional locally: without it the
# verdict cache, stats and rate limiting are skipped.
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Google Gemini API key for judging free-text rule guesses.
GEMINI_API_KEY=
# Model that judges players' rule guesses (default gemini-2.5-flash). gemini-decision-1 uses the Decisions API.
GEMINI_MODEL=gemini-2.5-flash
# Gemini 3.x only: thinking level for judging / writing puzzles (default low)
GEMINI_THINKING_LEVEL=
GEMINI_GENERATOR_THINKING_LEVEL=
# Optional salt for hashing IPs in the rate_limit table.
IP_HASH_SALT=change-me
# Password for the /admin puzzle desk (12+ characters). Admin is disabled when unset.
ADMIN_TOKEN=
# Optional: a different (stronger) Gemini model just for writing puzzles.
GEMINI_GENERATOR_MODEL=
# Second look at flagged guesses, and second opinion on unsure decisions (text models; default gemini-2.5-flash)
GEMINI_REVIEW_MODEL=
GEMINI_SECOND_OPINION_MODEL=
# Push reminders for the /admin desk. Create a key pair once with: npm run vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Vercel sends this to the daily reminder cron as "Authorization: Bearer <CRON_SECRET>". Any long random string.
CRON_SECRET=
