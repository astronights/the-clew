{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/|admin).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/admin/generate.ts": {
      "includeFiles": "prompts/**",
      "maxDuration": 60
    },
    "api/admin/revise.ts": {
      "includeFiles": "prompts/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminder",
      "schedule": "7 17 * * *"
    }
  ]
}
